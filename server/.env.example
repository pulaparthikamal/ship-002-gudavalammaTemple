# App
NODE_ENV=development
PORT=5003
API_PREFIX=/api/v1
APP_NAME=MyApp
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/myapp_db
MONGO_MAX_POOL_SIZE=10

# JWT
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=no-reply@example.com
MAIL_PASS=your_mail_password
MAIL_FROM="MyApp <no-reply@example.com>"

# Pagination
DEFAULT_PAGE=1
DEFAULT_LIMIT=10

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Meta / Facebook / Instagram Graph API
FB_APP_ID=
FB_APP_SECRET=
FB_REDIRECT_URI=http://localhost:5003/auth/facebook/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5003/auth/instagram/callback
PUBLIC_API_BASE_URL=http://localhost:5003

# AI server management integrations
SERVER_SECRET=change-me-for-ssh-secret-encryption
AGENTIC_SERVER_URL=http://localhost:8000
AGENTIC_SERVER_API_KEY=change-me-shared-rcm-ai-key
AGENTIC_SERVER_TIMEOUT_MS=300000
RCM_AI_PROVIDER=ollama
RCM_AI_CLAIM_REVIEW_BLOCK_THRESHOLD=0.75
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_TIMEOUT_MS=300000
CHROMA_URL=http://localhost:8001
CHROMA_COLLECTION=server_maintenance_memory

# Facebook OAuth
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret
FB_REDIRECT_URI=http://localhost:5003/auth/facebook/callback

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:5003/auth/linkedin/callback

# Frontend URL (used for OAuth redirect after success)
FRONTEND_URL=http://localhost:5173

# Real-time eligibility integration
ELIGIBILITY_VENDOR_ENABLED=true
ELIGIBILITY_VENDOR_NAME=stedi
ELIGIBILITY_AUTH_URL=
ELIGIBILITY_AUDIENCE=
ELIGIBILITY_CLIENT_ID=
ELIGIBILITY_CLIENT_SECRET=
ELIGIBILITY_GRANT_TYPE=client_credentials
ELIGIBILITY_VERIFICATION_URL=https://healthcare.us.stedi.com/2024-04-01/change/medicalnetwork/eligibility/v3
ELIGIBILITY_REQUEST_TIMEOUT_MS=30000
ELIGIBILITY_DEFAULT_SERVICE_TYPE_CODE=30
ELIGIBILITY_PAYLOAD_VERSION=1.0.0
ELIGIBILITY_DEFAULT_PRIORITY=Normal
ELIGIBILITY_PAYER_IDENTIFIER_SOURCE=auto
ELIGIBILITY_DEFAULT_PROCEDURE_CODES=
ELIGIBILITY_DEFAULT_CATEGORIES=
ELIGIBILITY_DEFAULT_PLAN_TYPES=
ELIGIBILITY_DEFAULT_NETWORK_STATUSES=
ELIGIBILITY_REVERIFICATION_DAYS=30
RCM_ELIGIBILITY_VALID_DAYS=7
ELIGIBILITY_STORE_RAW_PAYLOADS=false
STEDI_ELIGIBILITY_API_KEY=
STEDI_ELIGIBILITY_ENDPOINT=https://healthcare.us.stedi.com/2024-04-01/change/medicalnetwork/eligibility/v3

# Stedi claim submission integration
CLAIM_SUBMISSION_ENABLED=true
CLAIM_SUBMISSION_VENDOR_NAME=stedi
CLAIM_SUBMISSION_SUBMIT_URL=https://healthcare.us.stedi.com/2024-04-01/change/medicalnetwork/professionalclaims/v3/raw-x12-submission
CLAIM_SUBMISSION_TRANSPORT_MODE=x12
CLAIM_SUBMISSION_TIMEOUT_MS=30000
CLAIM_SUBMISSION_API_KEY=
CLAIM_SUBMISSION_API_KEY_HEADER=Authorization
CLAIM_SUBMISSION_AUTH_URL=
CLAIM_SUBMISSION_AUDIENCE=
CLAIM_SUBMISSION_CLIENT_ID=
CLAIM_SUBMISSION_CLIENT_SECRET=
CLAIM_SUBMISSION_GRANT_TYPE=client_credentials
CLAIM_SUBMISSION_WEBHOOK_SECRET=change-me-local-webhook-secret
STEDI_WEBHOOK_SECRET=
STEDI_WEBHOOK_SIGNATURE_HEADER=x-stedi-signature
STEDI_WEBHOOK_TIMESTAMP_HEADER=x-stedi-timestamp
STEDI_WEBHOOK_TOLERANCE_SECONDS=300
CLAIM_SUBMISSION_USAGE_INDICATOR=T
CLAIM_SUBMISSION_SENDER_ID=RCMTEST
CLAIM_SUBMISSION_RECEIVER_ID=STEDI
CLAIM_SUBMISSION_SUBMITTER_ID=RCMAPP
CLAIM_SUBMISSION_SUBMITTER_NAME=Realtime RCM Test Submitter
CLAIM_SUBMISSION_RECEIVER_NAME=Stedi
CLAIM_SUBMISSION_CONTACT_NAME=RCM Support
CLAIM_SUBMISSION_CONTACT_PHONE=8005551212
CLAIM_SUBMISSION_MAX_RETRIES=3
CLAIM_SUBMISSION_STORE_RAW_PAYLOADS=false
STEDI_API_KEY=
STEDI_SUBMIT_ENDPOINT=https://healthcare.us.stedi.com/2024-04-01/change/medicalnetwork/professionalclaims/v3/raw-x12-submission
STEDI_STATUS_ENDPOINT=https://core.us.stedi.com/2023-08-01/transactions
STEDI_TEST_PAYER_ID=
STEDI_TEST_BILLING_NPI=
STEDI_TEST_BILLING_TAX_ID=
STEDI_SUBMITTER_ID=
STEDI_RECEIVER_ID=
RCM_STEDI_DEBUG_LOGS=false

# RCM durable queue and HIPAA logging controls
RCM_QUEUE_DRIVER=mongo
RCM_QUEUE_WORKER_ENABLED=true
RCM_QUEUE_CONCURRENCY=3
RCM_QUEUE_WORKER_CONCURRENCY=3
RCM_QUEUE_WORKER_INTERVAL_MS=5000
RCM_QUEUE_MAX_ATTEMPTS=3
RCM_QUEUE_BACKOFF_MS=1000
RCM_QUEUE_RETRY_BASE_MS=1000
RCM_QUEUE_RETRY_MAX_MS=60000
RCM_REALTIME_ENABLED=true
RCM_REALTIME_MODE=sse
REDIS_URL=
RCM_REDIS_URL=
RCM_ALLOW_PHI_LOGS=false
RCM_REDACT_DIAGNOSIS_CODES=false
ERA_STORE_RAW_PAYLOADS=false
