# App
NODE_ENV=development
PORT=5003
API_PREFIX=/api/v1
APP_NAME=MyApp
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/templateDb
MONGO_MAX_POOL_SIZE=10

# JWT
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=no-reply@example.com
MAIL_PASS=your_mail_password
MAIL_FROM="MyApp <no-reply@example.com>"

# Pagination
DEFAULT_PAGE=1
DEFAULT_LIMIT=10

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Uploads
UPLOAD_ROOT_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=50

# Frontend URL (used for OAuth redirect after success)
FRONTEND_URL=http://localhost:5173

# LLM config
LLM_PROVIDER=ollama
LLM_MODEL=gpt-oss:120b-cloud
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_MS=300000

# Translation (LibreTranslate primary, LLM fallback for unsupported pairs)
TRANSLATION_PROVIDER=libretranslate
LIBRETRANSLATE_URL=http://localhost:5001
LIBRETRANSLATE_API_KEY=

# WhatsApp booking/donation confirmations via Meta's WhatsApp Cloud API
# (direct, no Twilio) — optional; leave blank to skip WhatsApp sends entirely.
# Requires a Meta Business + WhatsApp Business Platform phone number/access
# token (see developers.facebook.com/docs/whatsapp/cloud-api/get-started).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Meta requires an approved template for business-initiated messages. Defaults
# to Meta's own zero-parameter "hello_world" quickstart template; set these
# once you've created and had your own confirmation template approved.
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Separate template for mobile-number OTP login codes (Meta's "Authentication"
# template category — a distinct approval track from the confirmation template above).
WHATSAPP_OTP_TEMPLATE_NAME=hello_world
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
